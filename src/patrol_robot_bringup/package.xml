<?xml version="1.0"?>
<package format="3">
  <name>patrol_robot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for patrol robot simulation and navigation.</description>
  <maintainer email="maintainer@example.com">Patrol Robot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>patrol_robot_camera</exec_depend>
  <exec_depend>patrol_robot_gazebo</exec_depend>
  <exec_depend>patrol_robot_navigation</exec_depend>
  <exec_depend>patrol_robot_patrol</exec_depend>
  <exec_depend>patrol_robot_simulator</exec_depend>
  <exec_depend>patrol_robot_web_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
