<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pipeline_inspection">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>5.5645e-6 22.8758e-6 -42.3884e-6</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant></attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16 12 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16 12 0.1</size></box></geometry>
          <material><ambient>0.28 0.30 0.32 1</ambient><diffuse>0.35 0.37 0.39 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 四周墙体：地图范围为 x[-8,8], y[-6,6]。 -->
    <model name="north_wall"><static>true</static><pose>0 5.75 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>16 0.5 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>16 0.5 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -5.75 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>16 0.5 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>16 0.5 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>7.75 0 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 12 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 12 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-7.75 0 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 12 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 12 1.5</size></box></geometry><material><diffuse>0.65 0.68 0.72 1</diffuse></material></visual></link></model>

    <!-- 与预制地图对应的三组管道/设备障碍物。 -->
    <model name="pipe_rack_a">
      <static>true</static><pose>-2.75 1.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 4.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 4.0 1.2</size></box></geometry><material><diffuse>0.72 0.32 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pipe_rack_b">
      <static>true</static><pose>2.25 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 4.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 4.0 1.2</size></box></geometry><material><diffuse>0.72 0.32 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="control_cabinet">
      <static>true</static><pose>0.25 1.0 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1.0 1.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 1.0 1.4</size></box></geometry><material><diffuse>0.20 0.42 0.52 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
