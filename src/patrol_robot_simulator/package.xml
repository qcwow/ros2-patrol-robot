<?xml version="1.0"?>
<package format="3">
  <name>patrol_robot_simulator</name>
  <version>0.1.0</version>
  <description>Lightweight 2D patrol robot simulator without OpenGL dependencies.</description>
  <maintainer email="maintainer@example.com">Patrol Robot Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>patrol_robot_description</exec_depend>
  <exec_depend>patrol_robot_navigation</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
