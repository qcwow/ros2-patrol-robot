<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot">
  <!-- 将来适配真机时，优先修改下面这些尺寸和质量。 -->
  <xacro:property name="base_length" value="0.52"/>
  <xacro:property name="base_width" value="0.42"/>
  <xacro:property name="base_height" value="0.16"/>
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_radius" value="0.085"/>
  <xacro:property name="wheel_width" value="0.045"/>
  <xacro:property name="wheel_separation" value="0.39"/>

  <material name="blue">
    <color rgba="0.08 0.28 0.68 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.08 0.08 0.10 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.35 0.38 0.42 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <!-- 降低重心，抑制 Gazebo 中加减速和碰撞引起的俯仰。 -->
      <origin xyz="0 0 ${base_height * 0.38}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_mass * (base_width * base_width + base_height * base_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${base_mass * (base_length * base_length + base_height * base_height) / 12.0}"
        iyz="0"
        izz="${base_mass * (base_length * base_length + base_width * base_width) / 12.0}"/>
    </inertial>
  </link>

  <xacro:macro name="drive_wheel" params="prefix y">
    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.65"/>
        <inertia ixx="0.0022" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0007"/>
      </inertial>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!--
        车轮圆柱轴必须指向 base_link 的 +Y。原来的 +pi/2 会把局部 Z 轴
        转到 -Y，导致 Gazebo 物理运动方向与差速插件里程计方向相反。
      -->
      <origin xyz="0 ${y} 0" rpy="${-pi / 2.0} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel prefix="right" y="${-wheel_separation / 2.0}"/>

  <link name="rear_caster_link">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/>
    </inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="-0.19 0 -0.035" rpy="0 0 0"/>
  </joint>
  <gazebo reference="rear_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!--
    前万向轮与后万向轮形成完整支撑面。只有后万向轮时，重心位于驱动轴
    边缘，向前加速或碰到障碍后车体会翘起，导致激光扫描平面倾斜。
  -->
  <link name="front_caster_link">
    <visual>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/>
    </inertial>
  </link>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="0.19 0 -0.035" rpy="0 0 0"/>
  </joint>
  <gazebo reference="front_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.055" length="0.045"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.12 0 0.235" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <!-- 轮速积分仅保留为调试数据；导航使用下面的 Gazebo 真值里程计。 -->
      <odom_topic>/wheel_odom</odom_topic>
      <tf_topic>/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.8</max_angular_acceleration>
    </plugin>
    <!--
      3D 物理仿真会出现轮胎滑移。若用轮速积分发布 odom，物理车体上的
      laser_link 会逐渐与 TF 中的机器人分离，激光点云便会在地图中形成
      假墙。OdometryPublisher 直接使用 Gazebo 模型实际位姿，使导航、
      机器人模型和激光传感器始终处于同一坐标位置。
    -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
